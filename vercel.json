{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{bancos,nucleo}/**"
    }
  },
  "rewrites": [
    { "source": "/api/bancos", "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/api/conciliar", "destination": "/api/index" }
  ]
}
